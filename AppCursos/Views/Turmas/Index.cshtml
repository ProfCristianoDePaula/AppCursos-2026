@model IEnumerable<AppCursos.Models.Turma>

@{
    ViewData["Title"] = "Cadastro de Turmas";
}


<div class="container bg-black text-light p-5 rounded-3 shadow mt-5">
   
    <div class="d-flex justify-content-between">
        <h1 class="display-5 mb-4">Cadastro de <span class="text-white fw-bold">Turmas</span></h1>

        <a asp-action="Create" class="btn btn-outline-light fw-bold fs-6 px-5 py-3 mb-4"><i class="bi bi-plus-circle me-4"></i> ADICIONAR TURMA</a>
    </div>

    <table class="table table-striped table-hover table-dark mt-4">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Curso)
                </th>
                <th>
                   Carga Horária
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Professor)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.Nome)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Curso.Nome)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Curso.Duracao)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Professor.Nome)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="link-light text-decoration-none ms-3"><i class="bi bi-pencil-square"></i ></a> 
                    <a asp-action="Details" asp-route-id="@item.Id" class="link-light text-decoration-none ms-3"><i class="bi bi-info-circle"></i></a> 
                    <a asp-action="Delete" asp-route-id="@item.Id" class="link-light text-decoration-none ms-3"><i class="bi bi-trash3"></i></a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>