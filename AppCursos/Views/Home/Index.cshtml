@{
    ViewData["Title"] = "Página Inicial";
}

<div class="container text-light py-4">
    <section class="p-4 p-md-5 mb-4 bg-black rounded-4 shadow border border-secondary-subtle">
        <div class="row align-items-center g-4">
            <div class="col-12 col-lg-6">
                <h1 class="display-5 mb-3">
                    <i class="bi bi-pc-display-horizontal me-2"></i>Edu<span class="fw-bolder">Tech</span>
                </h1>
                <p class="lead text-secondary-emphasis">
                    Formação em tecnologia com foco em prática, inovação e desenvolvimento profissional.
                </p>
                <p class="text-light-emphasis mb-4">
                    Organize turmas, acompanhe alunos e conduza cursos de informática em uma plataforma moderna e intuitiva.
                </p>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Cursos" asp-action="Index" class="btn btn-primary px-4">Explorar Cursos</a>
                    <a asp-controller="Alunos" asp-action="Index" class="btn btn-outline-light px-4">Ver Alunos</a>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div id="edutechCarousel" class="carousel slide carousel-fade rounded-4 overflow-hidden shadow" data-bs-ride="carousel">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#edutechCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#edutechCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#edutechCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?auto=format&fit=crop&w=1200&q=80" class="d-block w-100" alt="Laboratório de informática">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3">
                                <h5>Ambientes de Aprendizagem</h5>
                                <p>Estrutura preparada para aulas práticas de tecnologia.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=1200&q=80" class="d-block w-100" alt="Estudantes colaborando">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3">
                                <h5>Aprendizado Colaborativo</h5>
                                <p>Turmas com acompanhamento próximo de professores.</p>
                            </div>
                        </div>
                        <div class="carousel-item">
                            <img src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&w=1200&q=80" class="d-block w-100" alt="Código em desenvolvimento">
                            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded-3">
                                <h5>Projetos Reais</h5>
                                <p>Conteúdos conectados às demandas do mercado.</p>
                            </div>
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#edutechCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Anterior</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#edutechCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Próximo</span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <section class="mb-4">
        <div class="row g-4">
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100 bg-black text-light border-secondary-subtle shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-mortarboard fs-2 text-primary"></i>
                        <h5 class="card-title mt-3">Formação Completa</h5>
                        <p class="card-text text-light-emphasis">Trilhas para iniciantes e avançados com conteúdos atualizados.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100 bg-black text-light border-secondary-subtle shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-people fs-2 text-primary"></i>
                        <h5 class="card-title mt-3">Comunidade Ativa</h5>
                        <p class="card-text text-light-emphasis">Alunos e professores conectados para troca de experiências.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100 bg-black text-light border-secondary-subtle shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-bar-chart fs-2 text-primary"></i>
                        <h5 class="card-title mt-3">Evolução Contínua</h5>
                        <p class="card-text text-light-emphasis">Acompanhamento de desempenho para melhores resultados.</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-xl-3">
                <div class="card h-100 bg-black text-light border-secondary-subtle shadow-sm">
                    <div class="card-body">
                        <i class="bi bi-shield-check fs-2 text-primary"></i>
                        <h5 class="card-title mt-3">Gestão Segura</h5>
                        <p class="card-text text-light-emphasis">Processos organizados com foco em confiabilidade e qualidade.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-4 mb-4">
        <div class="col-12 col-lg-6">
            <div class="p-4 bg-black rounded-4 border border-secondary-subtle h-100">
                <h3 class="h4 mb-3">Nossos focos de aprendizagem</h3>
                <p class="text-light-emphasis mb-4">Capacitação prática nas áreas mais procuradas do universo digital.</p>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>Lógica de Programação</span><span>90%</span></div>
                    <div class="progress bg-secondary" role="progressbar" aria-label="Lógica de Programação" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 90%"></div>
                    </div>
                </div>
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1"><span>Desenvolvimento Web</span><span>85%</span></div>
                    <div class="progress bg-secondary" role="progressbar" aria-label="Desenvolvimento Web" aria-valuenow="85" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 85%"></div>
                    </div>
                </div>
                <div>
                    <div class="d-flex justify-content-between mb-1"><span>Produtividade Digital</span><span>95%</span></div>
                    <div class="progress bg-secondary" role="progressbar" aria-label="Produtividade Digital" aria-valuenow="95" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: 95%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-6">
            <div class="accordion" id="accordionEduTech">
                <div class="accordion-item bg-black text-light border-secondary-subtle">
                    <h2 class="accordion-header">
                        <button class="accordion-button bg-black text-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                            Missão da EduTech
                        </button>
                    </h2>
                    <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#accordionEduTech">
                        <div class="accordion-body text-light-emphasis">
                            Transformar conhecimento em oportunidades reais por meio da educação tecnológica.
                        </div>
                    </div>
                </div>
                <div class="accordion-item bg-black text-light border-secondary-subtle">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-black text-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                            Metodologia
                        </button>
                    </h2>
                    <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#accordionEduTech">
                        <div class="accordion-body text-light-emphasis">
                            Aprendizado orientado a projetos, com acompanhamento de desempenho e prática contínua.
                        </div>
                    </div>
                </div>
                <div class="accordion-item bg-black text-light border-secondary-subtle">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-black text-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                            Resultados Esperados
                        </button>
                    </h2>
                    <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#accordionEduTech">
                        <div class="accordion-body text-light-emphasis">
                            Profissionais mais preparados para o mercado, com base sólida em ferramentas digitais e programação.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="p-4 bg-black rounded-4 border border-secondary-subtle text-center mb-2">
        <h2 class="h4 mb-3">Edu<span class="fw-bolder">Tech</span> em movimento</h2>
        <p class="text-light-emphasis mb-3">Conectando tecnologia, ensino e transformação profissional.</p>
        <a asp-controller="Turmas" asp-action="Index" class="btn btn-outline-primary px-4">Acessar Turmas</a>
    </section>
</div>
