@model AppCursos.Models.Professor

@{
    ViewData["Title"] = "Cadastrar Novo Professor";
}

<div class="container bg-black text-light p-5 rounded-3 shadow mt-5">

    <h1 class="display-5 mb-4 text-center">Cadastro de <span class="text-white fw-bold">Professores</span></h1>
   
    <form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="row">
        <div class="col-12 mb-3">
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12 col-md-9 col-xl-10 mb-3">
            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>
        <div class="col-12 col-md-3 col-xl-2 mb-3">
            <div class="form-group">
                <label asp-for="Salario" class="control-label"></label>
                <input asp-for="Salario" class="form-control" />
                <span asp-validation-for="Salario" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-6">
            <div class="text-center">
                <a asp-action="Index" class="btn btn-outline-light w-100 py-3 fs-5"><i class="bi bi-arrow-clockwise me-3"></i> Cancelar</a>
            </div>
        </div>

        <div class="col-6">
            <div class="form-group text-center">

                <button class="btn btn-primary w-100 py-3 fs-5 "><i class="bi bi-floppy me-3"></i> Salvar</button>

            </div>
        </div>
    </div>
    </form>
</div>