@model AppCursos.Models.Aluno

@{
    ViewData["Title"] = "Cadastrar Novo Aluno";
}

<div class="container bg-black text-light p-5 rounded-3 shadow mt-5">

    <h1 class="display-5 mb-4 text-center">Cadastro de <span class="text-white fw-bold">Alunos</span></h1>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-12 col-md-8 col-xl-9 mb-3">
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control py-2"  placeholder="Digite seu nome completo..."/>
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-4 col-xl-3 mb-3">
                <div class="form-group">
                    <label asp-for="Celular" class="control-label"></label>
                    <input asp-for="Celular" class="form-control py-2" placeholder="(##) #.####-####" />
                    <span asp-validation-for="Celular" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input type="email" asp-for="Email" class="form-control py-2" placeholder="Digite seu e-mail..." />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <div class="form-group">
                    <label asp-for="CPF" class="control-label"></label>
                    <input asp-for="CPF" class="form-control py-2"
                    placeholder="###.###.###-##"/>
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <div class="form-group">
                    <label asp-for="DataNascimento" class="control-label"></label>
                    <input type="date" asp-for="DataNascimento" class="form-control py-2" />
                    <span asp-validation-for="DataNascimento" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-6">
                <div class="text-center">
                    <a asp-action="Index" class="btn btn-dark w-100 ">Cancelar</a>
                </div>
            </div>

            <div class="col-6">
                <div class="form-group text-center">
                    <input type="submit" value="Salvar" class="btn btn-primary w-100" />
                </div>
            </div>
        </div>
    </form>
</div>

        
@section Scripts {
    <script>
        $(function () {
            $("#CPF").mask("000.000.000-00");
            $("#Celular").mask("(00) 0.0000-0000");
        });
    </script>
}