@model AppCursos.Models.Aluno

@{
    ViewData["Title"] = "Cadastrar Novo Aluno";
}

<h1 class="display-5 text-center">Cadastrar Novo Aluno</h1>

<div class="container border border-2 rounded-4 bg-secondary p-5 shadow text-white">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col-12 col-md-8 col-xl-9 mb-3">
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-4 col-xl-3 mb-3">
                <div class="form-group">
                    <label asp-for="Celular" class="control-label"></label>
                    <input asp-for="Celular" class="form-control" />
                    <span asp-validation-for="Celular" class="text-danger"></span>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-group">
                    <label asp-for="Email" class="control-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <div class="form-group">
                    <label asp-for="CPF" class="control-label"></label>
                    <input asp-for="CPF" class="form-control" />
                    <span asp-validation-for="CPF" class="text-danger"></span>
                </div>
            </div>

            <div class="col-12 col-md-6 mb-3">
                <div class="form-group">
                    <label asp-for="DataNascimento" class="control-label"></label>
                    <input asp-for="DataNascimento" class="form-control" />
                    <span asp-validation-for="DataNascimento" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-6">
                <div class="text-center">
                    <a asp-action="Index" class="btn btn-dark w-100 ">Cancelar</a>
                </div>
            </div>

            <div class="col-6">
                <div class="form-group text-center">
                    <input type="submit" value="Salvar" class="btn btn-primary w-100" />
                </div>
            </div>
        </div>



    </form>
</div>