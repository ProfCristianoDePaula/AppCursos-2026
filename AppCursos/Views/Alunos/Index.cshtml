@model IEnumerable<AppCursos.Models.Aluno>

@{
    ViewData["Title"] = "Cadastro de Alunos";
}
<div class="d-flex justify-content-between my-5">
    <h1 class="display-5">Cadastro de Alunos</h1>

    <a asp-action="Create" class="btn btn-primary  pt-3 px-5 fw-bold fs-4">Adicionar</a>
</div>

<table class="table table-striped table-hover table-secondary">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CPF)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Celular)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataNascimento)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.CPF)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Celular)
            </td>
            <td>
                @Html.DisplayFor(model => item.DataNascimento)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary ms-2">Editar</a> 
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-success ms-2">Detalhes</a> 
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger ms-2">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>
